# Dummy, non-secret values for the hermetic E2E build (vite build --mode e2e).
# The host label "e2e" makes supabase-js read its session from the localStorage
# key sb-e2e-auth-token, which e2e/fixtures/hermetic.js seeds. No real project.
VITE_SUPABASE_URL=https://e2e.supabase.co
VITE_SUPABASE_ANON_KEY=e2e-dummy-anon-key
