{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }],
    "PreToolUse":       [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }],
    "PostToolUse":      [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }],
    "Notification":     [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }],
    "SubagentStop":     [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }],
    "PreCompact":       [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/tools/live/hook.mjs\"", "timeout": 3 }] }]
  }
}
