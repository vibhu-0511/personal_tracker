# Copy to .env for local dev. Never commit real values. In production set these in the
# Vercel project's environment variables.

# Server only (never prefix with VITE_).
GROQ_API_KEY=
# Optional. Code default is openai/gpt-oss-120b (DEFAULT_MODEL in api/agent.js).
GROQ_MODEL=openai/gpt-oss-120b
# Supabase user id of the single owner allowed to call /api/agent (fail-closed when unset).
OWNER_USER_ID=
# Optional. Comma-separated extra browser origins allowed by CORS on /api/*, added to the
# built-in defaults (capacitor://localhost, https://localhost, http://localhost:5173).
ALLOWED_ORIGINS=
# Optional. Per-user limits for /api/agent (positive integers). Read by the rate-limit
# wiring (R5-08); leave empty until that handler change lands.
AGENT_RATE_PER_MIN=
AGENT_RATE_PER_DAY=

# Client build-time (exposed to the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. Absolute API origin for builds that cannot use relative /api/* (e.g. the
# Capacitor iOS app). Empty means same-origin.
VITE_API_BASE=
